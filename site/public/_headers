# Cloudflare Pages header rules.
#
# Flutter names its files the same in every build (main.dart.js,
# canvaskit/, assets/), so a browser must not reuse any of the app's
# files without asking first. Every file not listed below gets Pages'
# default, max-age=0, must-revalidate: the browser asks on each load,
# and while the file is unchanged its etag gets "not modified". That
# holds only while the zone's browser cache TTL leaves Cache-Control
# alone (infra/cloudflare.mjs).

# Nobody else's page frames these. Subscribe and Drop are a tap each,
# and under another site's frame the taps are that site's to steer:
# frame-ancestors, and X-Frame-Options for browsers older than it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Which scripts may run in the app, and which workers it may start. The
# page keeps the device's secret key in its storage, which any script
# that runs in it can read, so the app names what may:
#   script-src  its own files ('self': Flutter's, app/web's, and the
#               scripts of its workers); WebAssembly ('wasm-unsafe-eval':
#               CanvasKit, the deal, the signature); New Relic's browser
#               agent, which fetches its parts from js-agent.newrelic.com
#               (app/web/observability.js); and Apple's sign-in script,
#               which the page fetches once a sign-in button is on the
#               screen (app/lib/net/provider_tokens_web.dart). No inline
#               script, no eval, no other origin. A sign-in provider's
#               origin is here only while the build is given that
#               provider's identifier (config/openhearts.json:
#               apple.servicesId, google.webClientId), which
#               site/headers.test.mjs holds it to.
#   worker-src  its own files, and a blob: the deal's worker is started
#               from one (packages/deal/lib/src/worker_web.dart), its
#               script fetched once, so that a worker started again needs
#               nothing from the network. A script may not be a blob, and
#               a worker has no localStorage.
# Pages joins the values of a header that more than one rule sets, and a
# browser enforces every policy of one so joined, so the frame-ancestors
# above would stand without this one saying it. It does, so that the
# app's policy is whole whichever way a platform combines them.
/play/*
  Content-Security-Policy: frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval' https://js-agent.newrelic.com https://appleid.cdn-apple.com; worker-src 'self' blob:

# Never cached: these are how a new deploy reaches a phone that already
# has the app open; a stale bootstrap would keep an old build running.
# The app's files are these on every host: play.openhearts.game's worker
# reads /main.dart.js from /play/main.dart.js (service/functions/app_host.mjs).
# /carry, the one page that may be framed (by play.openhearts.game, and
# nobody else), has its framing set by the worker.
/play/
  Cache-Control: no-store
/play/index.html
  Cache-Control: no-store
/play/flutter_bootstrap.js
  Cache-Control: no-store
/play/flutter_service_worker.js
  Cache-Control: no-store
/play/offline_worker.js
  Cache-Control: no-store
/play/build-info.json
  Cache-Control: no-store
