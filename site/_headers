# Cloudflare Pages header rules.
#
# The build is content-hashed by Flutter EXCEPT for the entry points, so
# the entry points must never be cached and everything else can be.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Never cached: these are how a new deploy reaches a phone that already
# has the app open. The dev loop publishes on every commit and a stale
# bootstrap makes the whole loop lie.
/play/
  Cache-Control: no-store
/play/index.html
  Cache-Control: no-store
/play/flutter_bootstrap.js
  Cache-Control: no-store
/play/flutter_service_worker.js
  Cache-Control: no-store
/play/build-info.json
  Cache-Control: no-store

/play/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# Benchmarks: the wasm is rebuilt with the deploy, so never let a phone
# time a stale one.
/measure/*
  Cache-Control: no-store
