# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
build/
.dart_tool/
# Libraries don't commit their lockfiles; the app and the service do.
packages/*/pubspec.lock
*.iml

# Rust (measurements)
measurements/*/target/
measurements/*/wasm/target/

# Tooling
node_modules/
.wrangler/

# The service's signing secret, as bin/service_key.dart wrote it before
# it printed it instead: a copy left on a disk is never a commit.
service.secret

# OS
.DS_Store

