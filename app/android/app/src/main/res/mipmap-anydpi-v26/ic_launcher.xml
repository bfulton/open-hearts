<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from Android 8 on: the felt and the heart as
     layers the launcher masks and moves (tool/icons.mjs makes both). The
     heart alone is also the themed icon's shape. Before Android 8, the
     launcher shows mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
