<?xml version="1.0" encoding="utf-8"?>
<!-- What Android 12 and later copy off the phone, to Google's backup and
     to a new phone: everything but the preferences file the device's
     secret key is in (lib/secret_store.dart, identityFile). The key is
     this device, and a copy of it elsewhere would be another device
     that was the same player. A phone restored or moved comes back as a
     new player and gets its account back with a backup code, a sign-in
     or Restore purchases. Nothing else is left out. Android 11 and
     earlier read backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="identity.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="identity.xml"/>
    </device-transfer>
</data-extraction-rules>
