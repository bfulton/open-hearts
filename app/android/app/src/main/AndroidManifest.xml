<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Everything live is on the network: the relay and the
         licence. The debug and profile manifests have INTERNET for the
         Flutter tool, but a release build reads only this one. The
         network's state was read by WebRTC's network monitor, which the
         app no longer carries; the permission stays until the merged
         release manifest shows nothing else reads it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Live play is bought as a Google Play subscription
         (lib/net/store_buying.dart). The Play Billing Library's own
         manifest declares this too; said here so the release manifest
         says it whatever the library does. -->
    <uses-permission android:name="com.android.vending.BILLING"/>
    <!-- Backups stay on (android:allowBackup is left at its default,
         on), minus the device's secret key (lib/secret_store.dart),
         which is left out, by the name of its file, of both a backup
         and a transfer to a new phone: by dataExtractionRules on
         Android 12 and later, and by fullBackupContent on 11 and
         earlier. -->
    <application
        android:label="Open Hearts"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- The window behind Flutter once it is drawing (styles.xml). -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The Flutter tool reads this to register the plugins. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Lets the engine list the apps that act on selected text, for a
         text field's menu (ProcessTextPlugin; Android's package
         visibility otherwise hides them). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
